
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>All Our Flats</h1>
  <%= link_to "Add a Flat", new_flat_path, class: "btn btn-success" %>
</div>

<div class="flats-list">
  <% @flats.each do |flat| %>  <!-- Ensure 'flat' is the block variable -->
    <div class="flat-card">
      <h2><%= flat.name %></h2>
      <p><i class="fa-solid fa-location-dot"></i> <%= flat.address %></p>
      <p><i class="fa-solid fa-users"></i> <%= flat.number_of_guests %> guests</p>
      <p><i class="fa-solid fa-dollar-sign"></i> <%= flat.price_per_night %> per night</p>
          <%= link_to "More Info", flat_path(flat), class: "btn btn-primary" %>
    </div>
  <% end %>

</div>
